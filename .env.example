# Copy this file to .env and set the database URL for your WasteWise database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
ORS_API_KEY=replace-with-your-openrouteservice-key

# Used by the API when it calls the algorithm service.
ALGORITHM_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
